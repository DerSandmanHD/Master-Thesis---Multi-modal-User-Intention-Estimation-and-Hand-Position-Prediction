      "id": "grouped_metrics",
      "command": "python3 Training/evaluation/evaluate_grouped_predictions.py --predictions <prediction_csv> --prediction-report <prediction_json> --report-out <report_dir>/grouped_metrics.json --table-out <report_dir>/grouped_metrics.csv --bootstrap-iterations 10000 --bootstrap-seed 42 --sequence-bootstrap",
