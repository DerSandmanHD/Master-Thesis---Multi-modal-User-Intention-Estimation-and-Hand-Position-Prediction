  "evaluation_only": [
    {
      "id": "t1_pose_baselines",
      "command": "python3 Training/export_residual_predictions.py --run-dir <validation_frozen_run> --checkpoint best_intention_model.pt --split test --final-test-report <authorized_final_test.json> --output-csv <report_dir>/test_predictions.csv --report-out <report_dir>/test_predictions.json",
      "methods": ["persistence", "constant_velocity", "learned_model_oracle_hand"],
      "primary_comparison": "test_predictions.json pose_comparison.methods.<method>.fair_common_metrics",
      "note": "evaluate_pose_baselines.py remains a model-independent two-baseline diagnostic; the checkpoint-bound export is the authoritative learned three-way comparison"
