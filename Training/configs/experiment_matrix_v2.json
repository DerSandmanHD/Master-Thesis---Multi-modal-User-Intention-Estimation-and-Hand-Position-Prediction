    },
    {
      "id": "qualitative_cases",
      "command": "python3 Training/render_prediction_overlay.py --predictions <prediction_csv> --prediction-report <prediction_json> --visual-cache-manifest <corrected_cache_manifest> --alignment-dir <sidecars> --output-dir <report_dir>",
      "cases": ["good", "typical", "failure"]
    }
