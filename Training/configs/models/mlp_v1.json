{
  "run_name": "mlp_v1",
  "model_type": "hierarchical_window_mlp",
  "data": {
    "master_dir": "Data_collection/master_datasets",
    "manifest_filter": {
      "path": "dataset_manifest.csv",
      "allowed_statuses": ["valid"],
      "allowed_next_actions": ["ready_for_master_merge"],
      "strict": true
    },
    "feature_profile": "multimodal_robot_frame_v1",
    "window_size": 60,
    "stride": 10,
    "future_horizon_seconds": 1.0,
    "pose_intent_ids": [2],
    "minimum_observed_fraction": 0.05,
    "max_timestamp_gap_seconds": 0.2,
    "validation_fraction": 0.2,
    "test_fraction": 0.2,
    "validation_participants": ["Atilla", "Ermal", "Vanessa"],
    "test_participants": ["Edu", "Jona", "Mona"]
  },
  "model": {
    "hidden_dims": [16, 128],
    "dropout": 0.15
  },
  "training": {
    "seed": 42,
    "epochs": 20,
    "batch_size": 32,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "assistance_loss_weight": 1.0,
    "assistance_type_loss_weight": 1.0,
    "pose_loss_weight": 1.0,
    "orientation_loss_weight": 0.25,
    "gradient_clip_norm": 1.0,
    "early_stopping_patience": 7,
    "num_workers": 2
  }
}
