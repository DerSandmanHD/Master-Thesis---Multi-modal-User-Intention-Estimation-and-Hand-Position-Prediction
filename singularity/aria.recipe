Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%help
    Singularity image for this Project Aria repository on the TCML cluster.

    Targeted scripts:
      - Code/vrs_to_mp4_all.py
      - Code/speech_recognition_demo.py
      - Code/extract_multimodal_data.py
      - Code/detect_tags.py
      - Code/run_yolo_detection.py
      - Code/dataset_qa.py
      - Code/Testing/*.py
      - GTN analysis/visualization scripts except model training

    Main runtime versions:
      - OS: Ubuntu 22.04
      - CUDA runtime: 12.4.1, used with singularity --nv on TCML
      - Python: 3.10
      - PyTorch: 2.4.1+cu124
      - OpenCV contrib headless: 4.10.0.84
      - Project Aria tools: 2.1.2
      - Project Aria MPS: 1.2.1
      - Faster-Whisper: 1.2.1
      - Ultralytics: 8.4.53

%labels
    maintainer dersandmannhd
    project "Multi-modal User Intention Estimation and Hand Position Prediction"
    version "v0.2"
    python.version "3.10"
    cuda.version "12.4.1"
    torch.version "2.4.1+cu124"
    opencv.version "4.10.0.84"
    projectaria_tools.version "2.1.2"
    faster_whisper.version "1.2.1"
    ultralytics.version "8.4.53"

%environment
    export VIRTUAL_ENV=/opt/aria_env
    export PATH=/opt/aria_env/bin:$PATH
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export MPLBACKEND=Agg
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
    export YOLO_CONFIG_DIR=${YOLO_CONFIG_DIR:-$HOME/.config/Ultralytics}

%post
    set -e

    export DEBIAN_FRONTEND=noninteractive
    ln -fs /usr/share/zoneinfo/Europe/Berlin /etc/localtime

    apt-get update --fix-missing
    apt-get install -y --no-install-recommends \
        tzdata \
        ca-certificates \
        git \
        build-essential \
        pkg-config \
        swig \
        ffmpeg \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        libglib2.0-0 \
        libgl1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libgomp1 \
        libsndfile1 \
        libjpeg-turbo8 \
        libpng16-16 \
        libtiff5 \
        libavcodec58 \
        libavformat58 \
        libavutil56

    dpkg-reconfigure --frontend noninteractive tzdata

    python3 -m venv /opt/aria_env
    . /opt/aria_env/bin/activate

    python -m pip install --upgrade pip setuptools wheel

    python -m pip install --no-cache-dir \
        torch==2.4.1+cu124 \
        torchvision==0.19.1+cu124 \
        torchaudio==2.4.1+cu124 \
        --index-url https://download.pytorch.org/whl/cu124

    python -m pip install --no-cache-dir \
        numpy==2.2.6 \
        scipy==1.15.3 \
        pandas==2.3.3 \
        matplotlib==3.10.9 \
        seaborn==0.13.2 \
        scikit-learn==1.5.2 \
        pillow==11.3.0 \
        tqdm==4.67.3 \
        pyyaml==6.0.3 \
        requests==2.34.2 \
        psutil==7.2.2 \
        py-cpuinfo==9.0.0 \
        opencv-contrib-python-headless==4.10.0.84 \
        av==17.0.1 \
        imageio==2.37.3 \
        imageio-ffmpeg==0.6.0 \
        moviepy==2.2.1 \
        faster-whisper==1.2.1 \
        ctranslate2==4.7.2 \
        openai-whisper==20250625 \
        ultralytics-thop==2.0.19 \
        projectaria-tools==2.1.2 \
        projectaria-mps==1.2.1 \
        projectaria-vrs-health-check==1.2.1 \
        rerun-sdk==0.26.2 \
        rerun-notebook==0.26.2 \
        plotly==6.7.0 \
        polars==1.41.0 \
        pyarrow==24.0.0 \
        dtw-python==1.5.3

    # Install Ultralytics without its OpenCV dependency so cv2.aruco from
    # opencv-contrib-python-headless remains available for Code/detect_tags.py.
    python -m pip install --no-cache-dir --no-deps ultralytics==8.4.53

    python -m pip check || true

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    echo "------------------------------------------------------------------"
    echo "Versions of installed tools:"
    python --version
    python -m pip --version
    python - <<'PY'
import cv2
import faster_whisper
from importlib.metadata import version
import numpy
import pandas
import scipy
import torch

print(f"numpy: {numpy.__version__}")
print(f"scipy: {scipy.__version__}")
print(f"pandas: {pandas.__version__}")
print(f"torch: {torch.__version__}")
print(f"torch cuda available at runtime: {torch.cuda.is_available()}")
print(f"opencv: {cv2.__version__}")
print(f"opencv aruco available: {hasattr(cv2, 'aruco')}")
print(f"faster-whisper: {version('faster-whisper')}")
print(f"projectaria-tools: {version('projectaria-tools')}")
print(f"ultralytics: {version('ultralytics')}")
PY
    echo "vrs_to_mp4: $(command -v vrs_to_mp4 || true)"
    echo "ffmpeg: $(command -v ffmpeg || true)"
    echo "------------------------------------------------------------------"

%test
    . /opt/aria_env/bin/activate
    python - <<'PY'
import cv2
import faster_whisper
import numpy
import scipy
import torch
from projectaria_tools.core import data_provider
from ultralytics import YOLO

assert hasattr(cv2, "aruco"), "OpenCV was installed without aruco support"
print("import smoke test passed")
print(f"torch={torch.__version__}, cuda_runtime={torch.version.cuda}")
PY
    command -v ffmpeg
    command -v vrs_to_mp4

%runscript
    exec python "$@"
